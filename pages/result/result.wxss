/* result.wxss */
page {
  background: linear-gradient(135deg, #f0f9ff 0%, #e6f7e6 100%);
  min-height: 100vh;
}

.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
}

.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.not-found .icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.not-found .title {
  font-size: 36rpx;
  color: #262626;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.not-found .desc {
  font-size: 32rpx;
  color: #52c41a;
  margin-bottom: 20rpx;
}

.not-found .tip {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-bottom: 60rpx;
  text-align: center;
  padding: 0 40rpx;
}

.success-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.badge-icon {
  width: 80rpx;
  height: 80rpx;
  background: #52c41a;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  margin-right: 20rpx;
}

.badge-text {
  font-size: 36rpx;
  color: #52c41a;
  font-weight: bold;
}

.standard-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.15);
  text-align: center;
}

.standard-no {
  display: block;
  font-size: 48rpx;
  color: #52c41a;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.standard-name {
  display: block;
  font-size: 32rpx;
  color: #595959;
}

.info-section {
  margin-bottom: 30rpx;
}

.info-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.title-text {
  font-size: 32rpx;
  color: #262626;
  font-weight: bold;
}

.info-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.1);
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.info-row .label {
  color: #8c8c8c;
  min-width: 160rpx;
}

.info-row .value {
  color: #262626;
  font-weight: 500;
}

.info-desc {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #595959;
  line-height: 1.6;
}

.quality-badge {
  display: inline-block;
  padding: 15rpx 40rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.quality-excellent {
  background: linear-gradient(135deg, #73d13d 0%, #52c41a 100%);
  color: white;
}

.quality-good {
  background: linear-gradient(135deg, #95de64 0%, #73d13d 100%);
  color: white;
}

.quality-medium {
  background: #ffc53d;
  color: white;
}

.quality-basic {
  background: #d9d9d9;
  color: #595959;
}

.quality-desc {
  font-size: 28rpx;
  color: #595959;
  line-height: 1.6;
}

.suggestion-card {
  background: linear-gradient(135deg, #f6ffed 0%, #ffffff 100%);
  border: 2rpx solid #b7eb8f;
}

.suggestion-text {
  display: block;
  font-size: 30rpx;
  color: #262626;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.tips {
  padding-top: 20rpx;
  border-top: 1rpx solid #d9f7be;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
  font-size: 26rpx;
  color: #595959;
}

.tip-icon {
  color: #52c41a;
  margin-right: 10rpx;
  font-weight: bold;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 50rpx;
}

.btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #73d13d 0%, #52c41a 100%);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(82, 196, 26, 0.3);
}

.btn-secondary {
  background: white;
  color: #52c41a;
  border: 2rpx solid #52c41a;
}
