/* index.wxss */
page {
  background: linear-gradient(135deg, #f0f9ff 0%, #e6f7e6 100%);
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  display: block;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #52c41a;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #8c8c8c;
}

.main-content {
  flex: 1;
}

/* 扫描动画 */
.scan-area {
  width: 100%;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.scan-box {
  width: 600rpx;
  height: 400rpx;
  border: 4rpx solid #52c41a;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
}

.scan-line {
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #52c41a, transparent);
  position: absolute;
  top: 0;
  animation: scan 2s linear infinite;
  box-shadow: 0 0 20rpx #52c41a;
}

@keyframes scan {
  0% { top: 0; }
  100% { top: 100%; }
}

.scan-text {
  position: absolute;
  bottom: 40rpx;
  width: 100%;
  text-align: center;
  color: #52c41a;
  font-size: 32rpx;
  font-weight: bold;
}

/* 上传区域 */
.upload-area {
  width: 100%;
  height: 500rpx;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(82, 196, 26, 0.1);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #bfbfbf;
}

.icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.tip {
  font-size: 28rpx;
}

/* 按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 50rpx;
}

.btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #73d13d 0%, #52c41a 100%);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(82, 196, 26, 0.3);
}

.btn-secondary {
  background: white;
  color: #52c41a;
  border: 2rpx solid #52c41a;
}

.btn-icon {
  margin-right: 10rpx;
  font-size: 36rpx;
}

/* 手动输入 */
.manual-input {
  margin-bottom: 50rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #595959;
  margin-bottom: 20rpx;
}

.input-group {
  display: flex;
  gap: 20rpx;
}

.standard-input {
  flex: 1;
  height: 80rpx;
  background: white;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  border: 2rpx solid #d9d9d9;
}

.btn-search {
  width: 140rpx;
  height: 80rpx;
  background: #52c41a;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  padding: 0;
  border: none;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #8c8c8c;
}
